{
  "name": "assignment-checker",
  "displayName": "Phero Assignment Checker",
  "version": "0.3.0",
  "description": "Feedback builder, grading shortcuts and JSON rubric loader for Programming Hero instructors.",
  "author": "Md Shahriyar Alam <contact@shahriyar.dev>",
  "scripts": {
    "css": "tailwindcss -i ./src/styles.src.css -o ./src/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/styles.src.css -o ./src/styles.css --watch",
    "dev": "concurrently -k -n css,plasmo \"bun run css:watch\" \"plasmo dev\"",
    "build": "bun run css && plasmo build --zip",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "plasmo test"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.41.0",
    "moment": "^2.30.1",
    "plasmo": "0.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "host_permissions": [
      "https://web.programming-hero.com/instructor-dashboard*"
    ],
    "permissions": [
      "storage"
    ],
    "key": ""
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
